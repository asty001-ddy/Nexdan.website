---
// Product-style illustrations for the three services. Built in HTML/CSS so they stay sharp,
// translate with the page and mirror correctly in RTL. Decorative: the card text carries the meaning.
import { content, type Lang } from '../i18n/content';

interface Props { kind: 'ai' | 'code' | 'iot'; lang: Lang }
const { kind, lang } = Astro.props;
const d = content[lang].demos;
const bars = [58, 82, 70, 96, 88];
// Humidity readings across a day; the last ones cross the 60% limit.
const humidity = [48, 50, 47, 52, 55, 53, 57, 59, 62, 66, 68];
const hx = (i: number) => 8 + i * (264 / (humidity.length - 1));
const hy = (v: number) => 92 - (v - 40) * 2.6;
const line = humidity.map((v, i) => `${i ? 'L' : 'M'}${hx(i).toFixed(1)} ${hy(v).toFixed(1)}`).join('');
const area = `${line}L${hx(humidity.length - 1)} 96L8 96Z`;
---

{kind === 'ai' && (
  <div class="demo ai" aria-hidden="true">
    <div class="pane doc">
      <div class="file">
        <svg viewBox="0 0 16 20" width="14" height="18"><path d="M2 1h8l4 4v14H2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /><path d="M10 1v4h4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        <span class="fname" dir="auto">{d.ai.file}</span>
        <span class="chip ok"><i></i>{d.ai.status}</span>
      </div>
      <div class="page">
        <span style="width:46%" class="strong"></span><span style="width:82%"></span><span style="width:74%"></span>
        <span style="width:90%"></span><span style="width:38%" class="strong"></span><span style="width:66%"></span>
      </div>
    </div>
    <svg class="flow" viewBox="0 0 40 16" width="40" height="16"><path d="M2 8h34M30 3l6 5-6 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    <div class="pane fields">
      <p class="pane-title">{d.ai.heading}</p>
      <dl>
        {d.ai.fields.map(([k, v]) => (
          <div><dt>{k}</dt><dd dir="auto">{v}</dd></div>
        ))}
      </dl>
    </div>
  </div>
)}

{kind === 'code' && (
  <div class="demo app" aria-hidden="true">
    <div class="bar"><i></i><i></i><i></i><span>{d.software.app}</span></div>
    <div class="kpis">
      {d.software.kpis.map(([k, v]) => <div><span>{k}</span><strong>{v}</strong></div>)}
    </div>
    <p class="pane-title">{d.software.chart}</p>
    <div class="chart">
      {bars.map((h, i) => (
        <div class="col"><span class={i === 3 ? 'b hi' : 'b'} style={`height:${h}%`}></span><em>{d.software.days[i]}</em></div>
      ))}
    </div>
  </div>
)}

{kind === 'iot' && (
  <div class="demo iot" aria-hidden="true">
    <div class="head">
      <span class="live"><i></i>{d.iot.place}</span>
      <span class="metric">{d.iot.metric} <strong dir="ltr">{d.iot.value}</strong></span>
    </div>
    <svg class="spark" viewBox="0 0 280 100" preserveAspectRatio="none">
      <path d={area} class="area" />
      <path d={`M8 ${hy(60)}H272`} class="limit" />
      <path d={line} class="line" />
      <circle cx={hx(humidity.length - 1)} cy={hy(68)} r="4" class="now" />
    </svg>
    <div class="foot">
      <span class="limit-label">{d.iot.limit} <span dir="ltr">{d.iot.limitValue}</span></span>
      <span class="chip warn"><i></i>{d.iot.alert}</span>
    </div>
  </div>
)}

<style>
  .demo { min-width: 0; max-width: 100%; font-size: 0.78em; line-height: 1.4; color: var(--ink); font-variant-numeric: tabular-nums; }
  .pane-title { font-weight: 600; font-size: 0.78rem; color: var(--ink-muted); margin-block-end: 10px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font-size: 0.72rem; font-weight: 500; }
  .chip i { flex: none; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .chip.ok { background: #e7f2ea; color: #1f6b3a; }
  .chip.warn { background: #fbefd6; color: #7a5208; }

  /* AI: a document read into structured fields */
  .ai { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.15fr); align-items: center; gap: 12px; }
  .pane { background: var(--mist); border: 1px solid var(--card-line); border-radius: 12px; padding: 14px; min-width: 0; }
  .file { display: flex; align-items: center; gap: 8px; color: var(--ink-muted); margin-block-end: 14px; flex-wrap: wrap; }
  .fname { font-weight: 500; color: var(--ink); overflow-wrap: anywhere; min-width: 0; }
  .page { display: grid; gap: 8px; background: var(--white); border-radius: 8px; padding: 14px 12px; }
  .page span { height: 6px; border-radius: 3px; background: #dfe5f2; }
  .page span.strong { background: #c3cde3; }
  .flow { color: var(--gold-deep); }
  html[dir='rtl'] .flow { scale: -1 1; }
  dl { margin: 0; display: grid; gap: 6px; }
  dl div { display: flex; justify-content: space-between; gap: 12px; background: var(--white); border-radius: 8px; padding: 8px 10px; border-inline-start: 3px solid var(--gold); }
  dt { color: var(--ink-muted); }
  dd { margin: 0; font-weight: 600; text-align: end; }

  /* Software: an app window with a small dashboard */
  .app { background: var(--white); border: 1px solid var(--card-line); border-radius: 12px; overflow: hidden; }
  .bar { display: flex; align-items: center; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--card-line); background: var(--mist); }
  .bar i { width: 8px; height: 8px; border-radius: 50%; background: #c3cde3; }
  .bar span { margin-inline-start: 8px; font-weight: 600; font-size: 0.75rem; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 6.5em), 1fr)); gap: 8px; padding: 12px; }
  .kpis div { background: var(--mist); border-radius: 8px; padding: 8px 10px; display: grid; min-width: 0; overflow-wrap: anywhere; }
  .kpis span { color: var(--ink-muted); font-size: 0.7rem; }
  .kpis strong { font-size: 1.05rem; font-weight: 600; }
  .app .pane-title { padding-inline: 12px; margin-block-end: 6px; }
  .chart { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; align-items: end; height: 96px; padding: 0 12px 10px; }
  .col { display: grid; grid-template-rows: 1fr auto; height: 100%; justify-items: center; gap: 4px; }
  .b { align-self: end; width: 100%; max-width: 26px; border-radius: 4px 4px 0 0; background: #c3cde3; }
  .b.hi { background: var(--ink); }
  .col em { font-style: normal; color: var(--ink-muted); font-size: 0.66rem; }

  /* IoT: a live humidity reading crossing its limit */
  .iot { background: var(--white); border: 1px solid var(--card-line); border-radius: 12px; padding: 12px; }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-block-end: 8px; }
  .live { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.75rem; }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: #2f9e57; box-shadow: 0 0 0 3px #e7f2ea; }
  .metric { color: var(--ink-muted); }
  .metric strong { color: var(--ink); font-size: 1.05rem; margin-inline-start: 4px; }
  .spark { display: block; width: 100%; height: 88px; }
  .spark .area { fill: #eef2fa; }
  .spark .limit { stroke: var(--gold-deep); stroke-width: 1.2; stroke-dasharray: 4 4; fill: none; vector-effect: non-scaling-stroke; }
  .spark .line { stroke: var(--ink); stroke-width: 2; fill: none; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .spark .now { fill: var(--gold); stroke: var(--white); stroke-width: 2; }
  .iot .foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-block-start: 8px; }
  .limit-label { color: var(--gold-deep); font-size: 0.72rem; font-weight: 500; }

  @media (max-width: 520px) {
    .ai { grid-template-columns: 1fr; }
    .flow { rotate: 90deg; justify-self: center; }
    html[dir='rtl'] .flow { scale: 1 1; }
  }
</style>
