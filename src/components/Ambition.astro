---
// Infographic: the four 2030 targets of Saudi Arabia's National Strategy for Data and AI,
// each drawn as a unit chart so the quantity is visible, not only stated.
import { content, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = content[lang].ambition;
const year = new Date().getFullYear();
const progress = Math.min(100, Math.max(0, ((year - 2020) / 10) * 100));
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<section id="ambition" class="ambition" aria-labelledby="ambition-title">
  <div class="wrap">
    <div class="head">
      <h2 id="ambition-title">{a.title}</h2>
      <p>{a.intro}</p>
    </div>

    <div class="timeline" style={`--p:${progress}%`}>
      <div class="end start"><strong>{a.start}</strong><span>{a.startLabel}</span></div>
      <div class="track" aria-hidden="true"><span class="fill"></span><span class="now"><em>{a.now}</em></span></div>
      <div class="end"><strong>{a.end}</strong><span>{a.endLabel}</span></div>
    </div>

    <div class="panels">
      <article class="panel">
        <p class="figure"><span class="num">{a.invest.value}</span> <span class="unit">{a.invest.unit}</span></p>
        <p class="label">{a.invest.label}</p>
        <div class="ticks" aria-hidden="true"></div>
        <p class="key">{a.invest.key}</p>
      </article>

      <article class="panel">
        <p class="figure"><span class="num">{a.people.value}</span></p>
        <p class="label">{a.people.label}</p>
        <div class="dots" aria-hidden="true"></div>
        <p class="key">{a.people.key}</p>
      </article>

      <article class="panel">
        <p class="figure"><span class="num" dir="ltr">{a.startups.value}</span></p>
        <p class="label">{a.startups.label}</p>
        <div class="squares" aria-hidden="true"></div>
        <p class="key">{a.startups.key}</p>
      </article>

      <article class="panel">
        <p class="figure"><span class="num">{a.rank.value}</span></p>
        <p class="label">{a.rank.label}</p>
        <div class="ladder" aria-hidden="true" dir="ltr">
          {range(30).map((i) => <i class={i < 15 ? 'in' : ''} style={`height:${100 - i * 2.2}%`} />)}
        </div>
        <p class="key axis" dir="ltr"><span>1</span><span dir={lang === 'ar' ? 'rtl' : 'ltr'}>{a.rank.key}</span><span>30</span></p>
      </article>
    </div>

    <p class="source"><a href={a.sourceUrl} rel="noopener">{a.source}</a></p>
  </div>
</section>

<style>
  .ambition { padding-block: var(--section); }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px 48px; align-items: end; }
  .head p { color: var(--mist-on-dark); max-width: 50ch; font-size: 1.05rem; }

  /* 2020 → today → 2030 */
  .timeline { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 20px; margin-block: clamp(40px, 6vw, 64px) 24px; }
  .end { display: grid; gap: 2px; }
  .end:not(.start) { text-align: end; }
  .end strong { font-size: 1.35rem; font-weight: 500; font-variant-numeric: tabular-nums; }
  .end span { color: var(--mist-on-dark); font-size: 0.82rem; }
  .track { position: relative; height: 2px; background: var(--navy-line); }
  .fill { position: absolute; inset-block: 0; inset-inline-start: 0; width: var(--p); background: var(--gold); }
  .now { position: absolute; top: 50%; inset-inline-start: var(--p); width: 12px; height: 12px; margin-inline-start: -6px; margin-top: -6px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 5px rgb(228 176 74 / 0.18); }
  .now em { position: absolute; bottom: 20px; inset-inline-start: 50%; translate: -50% 0; font-style: normal; font-size: 0.78rem; color: var(--gold); white-space: nowrap; }
  html[dir='rtl'] .now em { translate: 50% 0; }

  .panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--navy-line); }
  .panel { padding: clamp(24px, 3.5vw, 40px) 0; display: grid; align-content: start; gap: 10px; min-width: 0; border-bottom: 1px solid var(--navy-line); }
  .panel:nth-child(odd) { padding-inline-end: clamp(20px, 3.5vw, 48px); border-inline-end: 1px solid var(--navy-line); }
  .panel:nth-child(even) { padding-inline-start: clamp(20px, 3.5vw, 48px); }
  .figure { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .num { font-size: clamp(2.8rem, 6vw, 4.6rem); font-weight: 300; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums lining-nums; }
  .unit { color: var(--gold); font-size: 1.1rem; font-weight: 500; }
  .label { color: var(--white); max-width: 36ch; }
  .key { color: var(--mist-on-dark); font-size: 0.8rem; }
  .axis { display: flex; justify-content: space-between; max-width: 360px; font-variant-numeric: tabular-nums; }

  /* Unit charts */
  /* Unit charts drawn as CSS patterns: each cell is one unit, so the counts are exact
     (75 x 1, 25 x 8 and 30 x 10) without hundreds of DOM nodes. */
  .ticks, .dots, .squares { margin-block-start: 14px; width: 100%; }
  .ticks { max-width: 460px; height: 34px; background: linear-gradient(90deg, var(--gold) 0 50%, transparent 50%) 0 0 / calc(100% / 75) 100% repeat-x; }
  .dots { max-width: 360px; aspect-ratio: 25 / 8; background: radial-gradient(circle closest-side, rgb(255 255 255 / 0.85) 0 62%, transparent 70%) 0 0 / calc(100% / 25) calc(100% / 8); }
  .squares {
    max-width: 360px; aspect-ratio: 30 / 10; background: var(--gold);
    -webkit-mask: linear-gradient(90deg, #000 0 74%, transparent 74%) 0 0 / calc(100% / 30) 100%, linear-gradient(#000 0 74%, transparent 74%) 0 0 / 100% calc(100% / 10);
    -webkit-mask-composite: source-in;
    mask: linear-gradient(90deg, #000 0 74%, transparent 74%) 0 0 / calc(100% / 30) 100%, linear-gradient(#000 0 74%, transparent 74%) 0 0 / 100% calc(100% / 10);
    mask-composite: intersect;
  }
  .ladder { display: flex; align-items: end; gap: 4px; height: 64px; margin-block-start: 14px; max-width: 360px; }
  .ladder i { flex: 1; border-radius: 2px 2px 0 0; background: var(--navy-line); }
  .ladder i.in { background: var(--gold); }

  .source { margin-block-start: 24px; font-size: 0.82rem; }
  .source a { color: var(--mist-on-dark); text-underline-offset: 4px; display: inline-flex; min-height: 44px; align-items: center; }

  @media (max-width: 860px) {
    .head { grid-template-columns: 1fr; }
    .panels { grid-template-columns: 1fr; }
    .panel:nth-child(n) { padding-inline: 0; border-inline-end: 0; }
  }
</style>
