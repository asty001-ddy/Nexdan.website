---
import { content, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
// Latin-script brand words on the Arabic page get lang="en" so screen readers pronounce them correctly.
const latin = lang === 'ar' ? 'en' : undefined;
const mailto = `mailto:${t.contact.email}?subject=${encodeURIComponent(t.contact.subject)}`;
// Stagger gaps shrink down the group so it reads as one wave rather than a metronome.
const delay = (i: number) => `--d:${[0, 60, 100, 125][i] ?? 125}ms`;

// Simple line icons matching the poster style (gold outline).
const icons: Record<string, string> = {
  growth: '<path d="M4 20V14M9 20V10M14 20V12M19 20V6M3 9l6-4 5 3 6-5"/>',
  network: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M10.8 7.2 6.2 15.8M13.2 7.2l4.6 8.6M7.5 18h9"/>',
  ai: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/><text x="12" y="14.5" font-size="6" text-anchor="middle" fill="currentColor" stroke="none" font-weight="700">AI</text>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/>',
  spark: '<path d="M11 3l1.9 5.1L18 10l-5.1 1.9L11 17l-1.9-5.1L4 10l5.1-1.9L11 3Z"/><path d="M18.5 15l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9.9-2.1Z"/>',
  code: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  iot: '<circle cx="12" cy="18" r="1.8"/><path d="M8.3 14.3a5.2 5.2 0 0 1 7.4 0M5.2 11.2a9.6 9.6 0 0 1 13.6 0M2.2 8.2a13.9 13.9 0 0 1 19.6 0"/>',
};
const serviceIcon = (name: string) => (name === 'ai' ? 'spark' : name);
---

<a class="skip" href="#main">{t.skip}</a>

<header class="top container">
  <a class="logo" href={lang === 'ar' ? '/' : '/en/'}>
    <span class="mark" aria-hidden="true">N<sup>D</sup></span>
    <span class="word" lang={latin}>NEXDAN</span>
  </a>
  <nav aria-label={t.nav.label}>
    <a href="#services">{t.nav.services}</a>
    <a href="#pillars">{t.nav.pillars}</a>
    <a href="#mission">{t.nav.mission}</a>
    <a href="#contact">{t.nav.contact}</a>
    <a class="switch" href={t.nav.switchHref} lang={lang === 'ar' ? 'en' : 'ar'} hreflang={lang === 'ar' ? 'en' : 'ar'}>{t.nav.switch}</a>
  </nav>
</header>

<main id="main" class="clip" tabindex="-1">
  <section class="hero container">
    <p class="tagline" lang={latin}>{t.hero.tagline}</p>
    <h1>{t.hero.title}</h1>
    <p class="lead">{t.hero.lead}</p>
    <a class="btn" href={mailto}>{t.hero.cta}</a>
  </section>

  <section id="services" class="container" aria-labelledby="services-title">
    <h2 id="services-title" class="eyebrow-rule">{t.services.title}</h2>
    <div class="services">
      {t.services.items.map((s, i) => (
        <article class="service card" data-reveal style={delay(i)}>
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="gold" aria-hidden="true" set:html={icons[serviceIcon(s.icon)]} />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container" aria-labelledby="name-title">
    <h2 id="name-title" class="eyebrow-rule">{t.name.title}</h2>
    <div class="letters card">
      {t.name.letters.map((l, i) => (
        <div class="letter" data-reveal style={delay(i)}>
          <span class="big gold" lang={latin}>{l.letter}</span>
          <span class="word" lang={latin}>{l.word}</span>
          <span class="meaning">{l.meaning}</span>
        </div>
      ))}
    </div>
  </section>

  <section id="pillars" class="container" aria-labelledby="pillars-title">
    <h2 id="pillars-title" class="eyebrow-rule">{t.pillars.title}</h2>
    <div class="pillars">
      {t.pillars.items.map((p, i) => (
        <article class="pillar" data-reveal style={delay(i)}>
          <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="gold" aria-hidden="true" set:html={icons[p.icon]} />
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="mission" class="container" aria-labelledby="mission-title">
    <div class="mission card" data-reveal>
      <h2 id="mission-title" class="badge">{t.mission.title}</h2>
      <p>{t.mission.text}</p>
    </div>
  </section>

  <section id="contact" class="container contact" aria-labelledby="contact-title">
    <h2 id="contact-title" class="eyebrow-rule">{t.contact.title}</h2>
    <div data-reveal>
      <p>{t.contact.text}</p>
      <a class="btn" href={mailto} dir="ltr">{t.contact.email}</a>
    </div>
  </section>
</main>

<footer class="container foot">
  <p>{t.footer}</p>
</footer>

<script is:inline>
  // Reveal below-the-fold content once as it scrolls into view. Without JS everything is
  // simply visible; with reduced motion the CSS keeps the fade and drops the movement.
  (function () {
    var els = document.querySelectorAll('[data-reveal]');
    if (!('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('reveal-ready');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>

<style>
  .clip { overflow-x: clip; }
  main:focus { outline: none; }

  /* Visible only when focused from the keyboard */
  .skip {
    position: absolute; inset-inline-start: 16px; top: 8px; z-index: 10;
    padding: 10px 16px; border-radius: 10px; background: var(--gold-400); color: var(--navy-950);
    font-weight: 700; text-decoration: none; transform: translateY(-150%);
  }
  .skip:focus-visible { transform: none; }

  .top { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 24px; flex-wrap: wrap; }
  .logo { display: flex; align-items: center; gap: 12px; min-height: 44px; text-decoration: none; }
  .mark { font-family: var(--font-latin); font-weight: 700; font-size: 1.8rem; line-height: 1; }
  .mark sup { color: var(--gold-400); font-size: 0.55em; }
  .logo .word { font-family: var(--font-latin); font-weight: 600; letter-spacing: 0.35em; }
  nav { display: flex; gap: 8px 12px; flex-wrap: wrap; font-weight: 500; }
  /* 44px hit areas (Fitts); colour-only hover, no motion on frequently used links */
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 8px; text-decoration: none; color: var(--mist); transition: color 150ms ease; }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover { color: var(--white); }
  }
  nav .switch { color: var(--gold-400); }

  .hero { position: relative; isolation: isolate; text-align: center; max-width: 880px; padding-block-start: clamp(48px, 8vw, 96px); }
  /* One background texture for the hero only: a faint square-dot grid that fades out at the edges */
  .hero::before {
    content: ''; position: absolute; z-index: -1; inset: 0 -40vw;
    background-image: radial-gradient(circle, var(--dot) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(60% 70% at 50% 45%, #000 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(60% 70% at 50% 45%, #000 0%, transparent 75%);
    pointer-events: none;
  }
  .tagline { font-family: var(--font-latin); letter-spacing: 0.3em; text-transform: uppercase; font-size: 0.8rem; color: var(--gold-400); margin: 0 0 16px; }
  h1 { font-size: clamp(1.9rem, 4.6vw, 3.2rem); line-height: 1.15; margin: 0 0 20px; text-wrap: balance; }
  :global(html[dir='ltr']) h1 { letter-spacing: -0.02em; }
  :global(html[dir='rtl']) h1 { line-height: 1.35; }
  .lead { color: var(--mist); font-size: clamp(1rem, 1.6vw, 1.15rem); margin: 0 auto 32px; max-width: 62ch; text-wrap: pretty; }

  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .service { padding: 28px 24px; }
  .service h3 { margin: 16px 0 8px; font-size: 1.15rem; }
  .service p { margin: 0; color: var(--mist); max-width: 45ch; }

  .letters { display: grid; grid-template-columns: repeat(4, 1fr); padding: 24px 8px; }
  .letter { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; padding-inline: 12px; min-width: 0; }
  .letter + .letter { border-inline-start: 1px solid var(--line); }
  .letter .big { font-family: var(--font-latin); font-size: 2.8rem; font-weight: 700; line-height: 1; }
  .letter .word { font-family: var(--font-latin); font-weight: 700; }
  .letter .meaning { color: var(--mist); font-size: 0.95rem; }

  .pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .pillar { text-align: center; padding: 8px 12px; min-width: 0; }
  .pillar + .pillar { border-inline-start: 1px solid var(--line); }
  .pillar h3 { margin: 14px 0 6px; font-size: 1.1rem; text-wrap: balance; }
  .pillar p { margin: 0; color: var(--mist); }
  .pillar svg { margin-inline: auto; }

  .mission { text-align: center; padding: 0 24px 32px; max-width: 900px; margin-inline: auto; }
  /* In normal flow and pulled up over the top border, so a badge that wraps (translation, large text)
     pushes the text down instead of covering it. */
  .badge { width: max-content; max-width: 100%; margin: calc(-0.7em - 6px) auto 26px; padding: 6px 32px; border-radius: 10px; background: linear-gradient(90deg, var(--gold-600), var(--gold-400)); color: var(--navy-950); font-size: 1.3rem; line-height: 1.4; }
  .mission p { margin: 0 auto; max-width: 52ch; font-size: clamp(1.1rem, 2vw, 1.45rem); text-wrap: pretty; }

  .contact { text-align: center; }
  .contact p { color: var(--mist); margin: 0 auto 24px; max-width: 56ch; }

  .foot { padding-block: 32px; border-top: 1px solid var(--line); color: var(--mist); font-size: 0.9rem; text-align: center; }

  @media (max-width: 900px) {
    .services { grid-template-columns: 1fr; }
    .service p { max-width: none; }
  }
  @media (max-width: 760px) {
    /* Two columns on phones; one column when large text makes two too cramped */
    .letters, .pillars { grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr)); row-gap: 24px; }
    .letter + .letter, .pillar + .pillar { border-inline-start: 0; }
  }
</style>
