---
import { content, type Lang } from '../i18n/content';
import NetworkMap from './NetworkMap.astro';
import Logo from './Logo.astro';
import ServiceDemo from './ServiceDemo.astro';
import Ambition from './Ambition.astro';
import Ecosystem from './Ecosystem.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const dir = lang === 'ar' ? 'rtl' : 'ltr';
// Latin-script brand words on the Arabic page get lang="en" so screen readers pronounce them correctly.
const latin = lang === 'ar' ? 'en' : undefined;
const home = lang === 'ar' ? '/' : '/en/';
const mailto = `mailto:${t.contact.email}?subject=${encodeURIComponent(t.contact.subject)}`;

const pillarIcons: Record<string, string> = {
  growth: '<path d="M4 20V14M9 20V10M14 20V12M19 20V6M3 9l6-4 5 3 6-5"/>',
  network: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M10.8 7.2 6.2 15.8M13.2 7.2l4.6 8.6M7.5 18h9"/>',
  ai: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/><text x="12" y="14.5" font-size="6" text-anchor="middle" fill="currentColor" stroke="none" font-weight="700">AI</text>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/>',
};
const arrow = '<svg viewBox="0 0 16 12" width="16" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 6h13M9.5 1.5 14 6l-4.5 4.5"/></svg>';
---

<a class="skip" href="#main">{t.skip}</a>

<header class="top wrap">
  <Logo href={home} />
  <nav aria-label={t.nav.label}>
    <div class="sections">
      <a href="#services">{t.nav.services}</a>
      <a href="#process">{t.nav.process}</a>
      <a href="#pillars">{t.nav.pillars}</a>
      <a href="#contact">{t.nav.contact}</a>
    </div>
    <a class="switch" href={t.nav.switchHref} lang={lang === 'ar' ? 'en' : 'ar'} hreflang={lang === 'ar' ? 'en' : 'ar'}>{t.nav.switch}</a>
  </nav>
</header>

<main id="main" tabindex="-1">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="cta" href={mailto}><span class="arrow" set:html={arrow} /><span class="label">{t.hero.cta}</span></a>
          <a class="text-link" href="#services">{t.hero.secondary}</a>
        </div>
      </div>
      <NetworkMap lang={lang} label={t.map.label} jeddah={t.map.jeddah} riyadh={t.map.riyadh} />
    </div>
  </section>

  <section id="services" class="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-title">{t.services.title}</h2>
        <p>{t.services.intro}</p>
      </div>
      <div class="svc-grid">
        {t.services.items.map((s) => (
          <article class={`svc svc-${s.icon}`}>
            <div class="visual"><ServiceDemo kind={s.icon as 'ai' | 'code' | 'iot'} lang={lang} /></div>
            <div class="txt">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="note">{t.services.note}</p>
    </div>
  </section>

  <Ambition lang={lang} />

  <section id="process" class="process" aria-labelledby="process-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-title">{t.process.title}</h2>
        <p>{t.process.intro}</p>
      </div>
      <ol class="steps">
        {t.process.steps.map((s, i) => (
          <li>
            <span class="step-no" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <p class="out"><span>{t.process.outputLabel}</span>{s.output}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="name" aria-labelledby="name-title">
    <div class="wrap">
      <h2 id="name-title">{t.name.title}</h2>
      <ol class="letters" dir="ltr">
        {t.name.letters.map((l) => (
          <li>
            <span class="glyph" lang={latin} aria-hidden="true">{l.letter}</span>
            <span class="word" lang={latin}>{l.word}</span>
            <span class="meaning" dir={dir}>{l.meaning}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Ecosystem lang={lang} icons={pillarIcons} />

  <section id="mission" class="mission" aria-labelledby="mission-title">
    <div class="wrap mission-grid">
      <h2 id="mission-title">{t.mission.title}</h2>
      <p class="statement">{t.mission.text}</p>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 id="contact-title">{t.contact.heading}</h2>
      <div class="contact-row">
        <p>{t.contact.text}</p>
        <div class="contact-actions">
          <a class="cta" href={mailto}><span class="arrow" set:html={arrow} /><span class="label">{t.hero.cta}</span></a>
          <a class="email" href={mailto} dir="ltr">{t.contact.email}</a>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot-row">
    <div class="foot-brand">
      <Logo href={home} />
      <p lang={latin}>{t.hero.tagline}</p>
    </div>
    <p class="copy">{t.footer}</p>
  </div>
</footer>

<style>
  main:focus { outline: none; }
  /* SVG labels are allowed to overhang their box; never let them cause a sideways scroll */
  main { overflow-x: clip; }

  .skip {
    position: absolute; inset-inline-start: 16px; top: 8px; z-index: 10;
    padding: 10px 16px; border-radius: 10px; background: var(--gold); color: var(--night);
    font-weight: 600; text-decoration: none; transform: translateY(-150%);
  }
  .skip:focus-visible { transform: none; }

  /* Header */
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding-block: 20px; }
  nav { display: flex; align-items: center; gap: 8px; }
  .sections { display: flex; gap: 4px; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 12px; color: var(--mist-on-dark); text-decoration: none; font-size: 0.95rem; transition: color 150ms ease; }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover { color: var(--white); }
  }
  nav .switch { color: var(--white); border: 1px solid var(--navy-line); border-radius: 999px; padding-inline: 16px; margin-inline-start: 8px; }

  /* Hero */
  .hero { padding-block: clamp(32px, 6vw, 72px) var(--section); overflow-x: clip; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.95fr); align-items: center; gap: clamp(32px, 5vw, 72px); }
  h1 { font-size: clamp(2.1rem, 3.9vw, 3.5rem); font-weight: 600; line-height: 1.32; }
  html[lang='en'] h1 { line-height: 1.08; font-size: clamp(2.3rem, 4.8vw, 4.2rem); font-weight: 500; letter-spacing: -0.03em; }
  .lead { margin-block: 24px 36px; max-width: 54ch; color: var(--mist-on-dark); font-size: clamp(1.05rem, 1.4vw, 1.2rem); font-weight: 300; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }

  /* Shared section heading: statement on the start side, short intro on the other */
  .section-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; gap: 16px 48px; margin-block-end: clamp(32px, 5vw, 56px); }
  .section-head p { max-width: 46ch; font-size: 1.05rem; }

  /* Services: light section, product-style screens lead each card */
  .services { background: var(--mist); color: var(--ink); padding-block: var(--section); }
  .services .section-head p { color: var(--ink-muted); }
  .svc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .svc { background: var(--white); border: 1px solid var(--card-line); border-radius: 18px; padding: clamp(20px, 2.6vw, 32px); display: flex; flex-direction: column; }
  /* AI leads: a full-width card with the text on the start side and the screen beside it */
  .svc-ai { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); grid-template-areas: 'text visual'; align-items: center; column-gap: clamp(24px, 4vw, 56px); border-radius: 22px; }
  .svc-ai .txt { grid-area: text; }
  .visual { margin-block-end: 24px; min-width: 0; }
  .svc-ai .visual { grid-area: visual; margin: 0; font-size: 1.1rem; }
  .svc h3 { font-size: 1.25rem; margin-block-end: 6px; }
  .svc-ai h3 { font-size: clamp(1.45rem, 2.2vw, 1.8rem); }
  .svc p { color: var(--ink-muted); max-width: 50ch; }
  .note { margin-block-start: 16px; color: var(--ink-muted); font-size: 0.8rem; }

  /* Process: a real sequence, so it is numbered and joined by a line */
  .process { background: var(--mist); color: var(--ink); padding-block: var(--section); }
  .process .section-head p { color: var(--ink-muted); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; position: relative; }
  .steps::before { content: ''; position: absolute; inset-inline: 22px; top: 22px; height: 1px; background: var(--card-line); }
  .steps li { position: relative; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .step-no { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--ink); color: var(--white); font-weight: 600; font-variant-numeric: tabular-nums; margin-block-end: 12px; box-shadow: 0 0 0 6px var(--mist); }
  .steps h3 { font-size: 1.2rem; }
  .steps p { color: var(--ink-muted); }
  .out { margin-block-start: auto; padding-block-start: 12px; display: flex; flex-direction: column; gap: 2px; color: var(--ink) !important; font-weight: 600; border-top: 1px solid var(--card-line); }
  .out span { font-size: 0.75rem; font-weight: 500; color: var(--gold-deep); }

  /* Name: the letters themselves are the design. Always left to right, it is a Latin acronym. */
  .name { padding-block: var(--section) 0; }
  .letters { list-style: none; margin: clamp(32px, 5vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--navy-line); }
  .letters li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; padding-block: 24px 32px; min-width: 0; }
  .letters li + li { border-inline-start: 1px solid var(--navy-line); }
  .glyph { font-size: clamp(2.5rem, 13vw, 11rem); font-weight: 600; line-height: 1; color: #22387c; transition: color 250ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .letters li:hover .glyph { color: var(--gold); }
  }
  .word { font-weight: 600; font-size: 1.15rem; margin-block-start: 12px; overflow-wrap: break-word; hyphens: auto; max-width: 100%; }
  .meaning { color: var(--mist-on-dark); font-size: 0.95rem; max-width: 100%; overflow-wrap: break-word; hyphens: auto; }

  /* Mission: one large statement on a raised band */
  .mission { background: var(--navy-raised); padding-block: var(--section); }
  .mission-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 24px 48px; align-items: start; }
  .mission h2 { font-size: 1.2rem; color: var(--gold); padding-block-start: 0.6em; }
  .statement { font-size: clamp(1.5rem, 3.1vw, 2.5rem); line-height: 1.55; font-weight: 300; max-width: 32ch; }
  html[lang='en'] .statement { line-height: 1.3; letter-spacing: -0.015em; }

  /* Contact */
  .contact { padding-block: var(--section); }
  .contact h2 { font-size: clamp(2.4rem, 7vw, 5.6rem); line-height: 1.15; max-width: 16ch; }
  html[lang='en'] .contact h2 { line-height: 1.02; letter-spacing: -0.035em; }
  .contact-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px 64px; align-items: end; margin-block-start: clamp(28px, 4vw, 48px); padding-block-start: 32px; border-top: 1px solid var(--navy-line); }
  .contact-row p { color: var(--mist-on-dark); max-width: 46ch; font-size: 1.1rem; font-weight: 300; }
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .email { display: inline-flex; align-items: center; min-height: 44px; font-size: 1.15rem; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; text-decoration-color: var(--gold); overflow-wrap: anywhere; }

  /* Footer */
  .foot { border-top: 1px solid var(--navy-line); padding-block: 32px 40px; }
  .foot-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; }
  .foot-brand { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .foot-brand p { color: var(--mist-on-dark); font-size: 0.85rem; letter-spacing: 0.04em; }
  .copy { color: var(--mist-on-dark); font-size: 0.9rem; }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
    .section-head, .mission-grid, .contact-row { grid-template-columns: 1fr; }
    .svc-grid { grid-template-columns: 1fr; }
    .svc-ai { grid-template-columns: 1fr; grid-template-areas: 'visual' 'text'; row-gap: 24px; }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
    .steps::before { display: none; }
  }
  @media (max-width: 720px) {
    .sections { display: none; }
    .glyph { font-size: clamp(2.5rem, 22vw, 6rem); }
    .letters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .letters li + li:nth-child(3) { border-inline-start: 0; }
    .letters li:nth-child(n + 3) { border-block-start: 1px solid var(--navy-line); }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
